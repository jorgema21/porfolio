	},
	"dependencies": {
		"d3": "^7.9.0",
		"d3-array": "^3.2.4",
		"d3-hierarchy": "^3.1.2",
		"d3-scale": "^4.0.2",
		"gray-matter": "^4.0.3",
		"marked": "^18.1.2"
